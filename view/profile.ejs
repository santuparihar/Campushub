
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CampusHub - Profile</title>

    <link rel="stylesheet" href="/profile.css">
</head>

<body>

    <!-- Sidebar -->
    <aside class="sidebar">

        <div class="logo">
            <span>Campus</span>Hub
        </div>

        <nav class="sidebar-nav">

            <a href="/main">
                <span>⌂</span>
                Home
            </a>

            <a href="/profile" class="active">
                <span>◉</span>
                Profile
            </a>

            <a href="/main/profile/course">
                <span>▣</span>
                Courses
            </a>

            <a href="/main/profile/resources">
                <span>◫</span>
                Resources
            </a>

            <a href="/main/community">
                <span>♧</span>
                Community
            </a>

            <a href="/main/AI-helper">
                <span>✦</span>
                AI Assistant
            </a>

        </nav>

        <div class="sidebar-bottom">

            <a href="/main/settings">
                <span>⚙</span>
                Settings
            </a>

            <a href="/main/logout" class="logout">
                <span>↪</span>
                Logout
            </a>

        </div>

    </aside>


    <!-- Main Area -->
    <main class="main-content">

        <!-- Top Navbar -->
        <header class="topbar">

            <div class="mobile-logo">
                CampusHub
            </div>

            <div class="search-box">
                <span>⌕</span>
                <input
                    type="text"
                    placeholder="Search CampusHub..."
                >
            </div>

            <div class="topbar-right">

                <button class="notification">
                    🔔
                    <span class="notification-dot"></span>
                </button>

                <div class="mini-profile">
                    <div class="mini-avatar">
                        <img src="/uploads/<%= user.photo %>">
                    </div>

                    <div>
                        <p><%= user.name %></p>
                        <span>Student</span>
                    </div>
                </div>

            </div>

        </header>


        <!-- Profile Content -->
        <section class="profile-container">

            <!-- Page Heading -->
            <div class="page-heading">

                <div>
                    <h1>My Profile</h1>
                    <p>Manage your personal and academic information.</p>
                </div>

                <button class="edit-btn">
                    <a href="/main/profile/edit"> ✎ Edit Profile </a>
                </button>

            </div>


            <!-- Profile Header Card -->
            <div class="profile-header-card">
             
                   <div class="profile-avatar">
                     <img src="/uploads/<%= user.photo %>">
                </div>
             </form>
            

                <div class="profile-main-info">

                    <h2><%= user.name %></h2>

                    <p class="student-role">
                       Student
                    </p>

                    <p class="college">
                        ITM University Gwalior
                    </p>

                    <div class="profile-tags">

                        <span>
                            <%= user.course %>
                        </span>

                        <span>
                             <%= user.year %>
                        </span>

                    </div>

                </div>

            </div>


            <!-- Information Grid -->
            <div class="information-grid">


                <!-- Personal Information -->
                <div class="info-card">

                    <div class="card-heading">

                        <div class="heading-icon">
                            👤
                        </div>

                        <div>
                            <h3>Personal Information</h3>
                            <p>Your basic personal details</p>
                        </div>

                    </div>


                    <div class="info-list">

                        <div class="info-item">

                            <div>
                                <span class="label">
                                    Full Name
                                </span>

                                <p>
                                    <%= user.name %>
                                </p>
                            </div>

                        </div>


                        <div class="info-item">

                            <div>
                                <span class="label">
                                    Email
                                </span>

                                <p>
                                    <%= user.email %>
                                </p>
                            </div>

                        </div>


                        <div class="info-item">

                            <div>
                                <span class="label">
                                    Gender
                                </span>

                                <p>
                                     <%= user.gender %>
                                </p>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Academic Information -->
                <div class="info-card">

                    <div class="card-heading">

                        <div class="heading-icon">
                            🎓
                        </div>

                        <div>
                            <h3>Academic Information</h3>
                            <p>Your college information</p>
                        </div>

                    </div>


                    <div class="info-list">

                        <div class="info-item">

                            <div>
                                <span class="label">
                                    College
                                </span>

                                <p>
                                    ITM University
                                </p>
                            </div>

                        </div>


                        <div class="info-item">

                            <div>
                                <span class="label">
                                    Course
                                </span>

                                <p>
                                     <%= user.course %>
                                </p>
                            </div>

                        </div>


                        <div class="info-item">

                            <div>
                                <span class="label">
                                    Semester
                                </span>

                                <p>
                                    <%= user.year %>
                                </p>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- CampusHub Stats -->
            <div class="stats-card">

                <div class="stats-heading">

                    <div>
                        <h3>CampusHub Activity</h3>
                        <p>Your activity on CampusHub</p>
                    </div>

                </div>


                <div class="stats-grid">

                    <div class="stat">

                        <strong>0</strong>

                        <span>Posts</span>

                    </div>


                    <div class="stat">

                        <strong>0</strong>

                        <span>Comments</span>

                    </div>


                    <div class="stat">

                        <strong>0</strong>

                        <span>Resources</span>

                    </div>


                    <div class="stat">

                        <strong>0</strong>

                        <span>Events Joined</span>

                    </div>

                </div>

            </div>

        </section>

    </main>

</body>
</html>