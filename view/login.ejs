<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | CampusHub</title>
    <link rel="stylesheet" href="login.css">
</head>

<body>

    <div class="login-container">

        <!-- Left Side -->
        <div class="login-info">
            <div class="brand">
                <div class="logo">🎓</div>
                <span>CAMPUS<span>HUB</span></span>
            </div>

            <div class="info-content">
                <h1>Welcome<br>Back!</h1>

                <p>
                    Your campus journey continues here.
                    Connect, learn, explore and make the
                    most out of your college life.
                </p>

                <div class="quote">
                    "Your campus. Your people. Your journey."
                </div>
            </div>
        </div>


        <!-- Right Side -->
        <div class="login-box">

            <h2>Login</h2>
            <p class="subtitle">Welcome back to CampusHub</p>

            <form action="/login" method="post">

                <div class="input-group">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        placeholder="Enter your email"
                        name="email"
                        required
                    >
                </div>

                <div class="input-group">
                    <div class="password-label">
                        <label for="password">Password</label>
                        <a href="#">Forgot Password?</a>
                    </div>

                    <input
                        type="password"
                        id="password"
                        placeholder="Enter your password"
                        name="password"
                        required
                    >
                </div>

                <div class="remember">
                    <label>
                        <input type="checkbox">
                        Remember me
                    </label>
                </div>

                <button type="submit">
                    Login <span>→</span>
                </button>

            </form>

            <div class="divider">
                <span>OR</span>
            </div>

            <button class="google-btn">
                <span>G</span>
                Continue with Google
            </button>

            <p class="signup-text">
                Don't have an account?
                <a href="signup">Sign Up</a>
            </p>

        </div>

    </div>

</body>
</html>