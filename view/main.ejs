<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CampusHub Dashboard</title>

    <!-- Font Awesome Icons -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <!-- External CSS -->
    <link rel="stylesheet" href="main.css">
</head>

<body>

    <!-- ================= TOP NAVBAR ================= -->

    <header class="topbar">

        <div class="brand">
            <div class="brand-logo">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <span>
                CAMPUS<span>HUB</span>
            </span>
        </div>


        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input
                type="text"
                placeholder="Search events, people, announcements..."
            >
        </div>


        <div class="top-actions">

            <button class="icon-btn notification">
                <i class="fa-regular fa-bell"></i>
                <span></span>
            </button>


            <div class="user-menu">

                <div class="avatar">
                    <img src="/uploads/<%= user.photo %>">
                </div>

                <strong>
                    <%= user.name %>
                </strong>

                <i class="fa-solid fa-chevron-down"></i>

            </div>

        </div>

    </header>



    <!-- ================= MAIN LAYOUT ================= -->

    <div class="layout">


        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar">

            <nav>

                <a href="/main" class="nav-item active">
                    <i class="fa-solid fa-house"></i>
                    <span>Dashboard</span>
                </a>


                <a href="/main/profile" class="nav-item">
                    <i class="fa-regular fa-user"></i>
                    <span>Profile</span>
                </a>


                <a href="/main/events" class="nav-item">
                    <i class="fa-regular fa-calendar"></i>
                    <span>Events</span>
                </a>


                <a href="/main/community" class="nav-item">
                    <i class="fa-solid fa-users"></i>
                    <span>Community</span>
                </a>


                <a href="/main/announcement" class="nav-item">
                    <i class="fa-solid fa-bullhorn"></i>
                    <span>Announcements</span>
                </a>


                <a href="/main/AI-helper" class="nav-item">
                    <i class="fa-solid fa-robot"></i>
                    <span>AI Helper</span>
                </a>


                <a href="/main/college-info" class="nav-item">
                    <i class="fa-solid fa-building-columns"></i>
                    <span>College Info</span>
                </a>


                <a href="/main/settings" class="nav-item">
                    <i class="fa-solid fa-gear"></i>
                    <span>Settings</span>
                </a>

            </nav>



            <!-- Sidebar bottom card -->

            <div class="sidebar-quote">

                <i class="fa-solid fa-graduation-cap"></i>

                <h3>
                    Better Students<br>
                    Bigger Dreams
                </h3>

                <p>
                    — CampusHub
                </p>

            </div>

        </aside>



        <!-- ================= MAIN CONTENT ================= -->

        <main class="content">

            <section class="dashboard-grid">


                <!-- ================= LEFT COLUMN ================= -->

                <div class="main-column">


                    <!-- ================= HERO ================= -->

                    <section class="hero">

                        <div class="hero-content">

                            <p class="eyebrow">
                                Welcome back,
                            </p>

          <h1>
             <%= user.name %> 👋
          </h1>


                            <p class="hero-text">
                                Keep learning, keep growing. Your journey
                                <br>
                                at CampusHub matters!
                            </p>


                            <div class="chips">

                                <span>
                                    <i class="fa-solid fa-building-columns"></i>
                                    ITM University Gwalior
                                </span>


                                <span>
                                    <i class="fa-solid fa-graduation-cap"></i>
                                     <%= user.course %>
                                </span>


                                <span>
                                    <i class="fa-regular fa-calendar"></i>
                                     <%= user.year %>
                                </span>

                            </div>

                        </div>


                        <div class="hero-slogan">

                            <span>Learn</span>
                            <span>Connect</span>
                            <span>Grow</span>

                            <div></div>

                        </div>

                    </section>



                    <!-- ================= FEATURE CARDS ================= -->

                    <section class="feature-grid">


                        <a href="/main/events" class="feature-card blue">

                            <div class="feature-icon">
                                <i class="fa-regular fa-calendar-days"></i>
                            </div>

                            <h3>
                                Upcoming Events
                            </h3>

                            <p>
                                Explore what's happening
                                <br>
                                on campus
                            </p>

                            <span class="round-arrow">
                                →
                            </span>

                        </a>



                        <a href="/main/community" class="feature-card green">

                            <div class="feature-icon">
                                <i class="fa-solid fa-user-group"></i>
                            </div>

                            <h3>
                                Find Students
                            </h3>

                            <p>
                                Connect with your
                                <br>
                                batchmates & seniors
                            </p>

                            <span class="round-arrow">
                                →
                            </span>

                        </a>



                        <a href="/main/AI-helper" class="feature-card purple">

                            <div class="feature-icon">
                                <i class="fa-solid fa-robot"></i>
                            </div>

                            <h3>
                                AI Helper
                            </h3>

                            <p>
                                Get instant help with
                                <br>
                                studies, doubts & more
                            </p>

                            <span class="round-arrow">
                                →
                            </span>

                        </a>



                        <a href="/main/announcement" class="feature-card orange">

                            <div class="feature-icon">
                                <i class="fa-solid fa-bullhorn"></i>
                            </div>

                            <h3>
                                Announcements
                            </h3>

                            <p>
                                Stay updated with
                                <br>
                                latest news
                            </p>

                            <span class="round-arrow">
                                →
                            </span>

                        </a>

                    </section>



                    <!-- ================= LOWER SECTION ================= -->

                    <section class="lower-grid">


                        <!-- ================= ANNOUNCEMENTS ================= -->

                        <div class="panel announcements">

                            <div class="panel-header">

                                <h2>
                                    <i class="fa-solid fa-bullhorn"></i>
                                    Latest Announcements
                                </h2>

                                <a href="/main/announcement">
                                    View All →
                                </a>

                            </div>



                            <article class="announcement">

                                <span class="tag academic">
                                    Academic
                                </span>

                                <div>

                                    <h3>
                                        Class Schedule Released
                                    </h3>

                                    <p>
                                        The class schedule for 1st semester
                                        has been released. Please check...
                                    </p>

                                </div>

                                <time>
                                    Sep 12, 2025
                                </time>

                            </article>



                            <article class="announcement">

                                <span class="tag event">
                                    Event
                                </span>

                                <div>

                                    <h3>
                                        Tech Talk: Building Scalable Systems
                                    </h3>

                                    <p>
                                        Join us for an insightful session
                                        on system design and real-world...
                                    </p>

                                </div>

                                <time>
                                    Sep 10, 2025
                                </time>

                            </article>



                            <article class="announcement">

                                <span class="tag notice">
                                    Notice
                                </span>

                                <div>

                                    <h3>
                                        Library Timings Updated
                                    </h3>

                                    <p>
                                        The library will now remain open
                                        from 8 AM to 8 PM (Mon-Sat).
                                    </p>

                                </div>

                                <time>
                                    Sep 8, 2025
                                </time>

                            </article>



                            <article class="announcement">

                                <span class="tag coding">
                                    Event
                                </span>

                                <div>

                                    <h3>
                                        Coding Competition - ICPC Prep
                                    </h3>

                                    <p>
                                        Open for all students.
                                        Register now and be a part of the practice...
                                    </p>

                                </div>

                                <time>
                                    Sep 5, 2025
                                </time>

                            </article>

                        </div>



                        <!-- ================= QUICK LINKS ================= -->

                        <div class="panel quick-links">

                            <div class="panel-header">

                                <h2>
                                    <i class="fa-solid fa-link"></i>
                                    Quick Links
                                </h2>

                            </div>


                            <a href="https://www.itmuniversity.ac.in/">
                                <i class="fa-solid fa-globe"></i>
                                <span>College Website</span>
                                <b>›</b>
                            </a>


                            <a href="https://mis.itmuniversity.ac.in/itmzone/login.php">
                                <i class="fa-solid fa-file-lines"></i>
                                <span>Examination Portal</span>
                                <b>›</b>
                            </a>


                            <a href="https://www.onlineresultportal.com/university/itm-university-gwalior/">
                                <i class="fa-solid fa-trophy"></i>
                                <span>Result Portal</span>
                                <b>›</b>
                            </a>


                            <a href="https://www.itmuniversity.ac.in/academics/library">
                                <i class="fa-solid fa-book-open"></i>
                                <span>Library Resources</span>
                                <b>›</b>
                            </a>


                            <a href="https://www.itmuniversity.ac.in/academics/library">
                                <i class="fa-solid fa-briefcase"></i>
                                <span>Placement Cell</span>
                                <b>›</b>
                            </a>


                            <a href="https://www.collegebatch.com/685-itm-university-hostel-fees-facilities-gwalior">
                                <i class="fa-solid fa-house"></i>
                                <span>Hostel Information</span>
                                <b>›</b>
                            </a>

                        </div>

                    </section>



                    <!-- ================= QUOTE ================= -->

                    <section class="quote-panel">

                        <strong>
                            “
                        </strong>

                        <em>
                            Small steps every day lead to big results.
                        </em>

                        <span>
                            — CampusHub
                        </span>

                    </section>

                </div>



                <!-- ================= RIGHT COLUMN ================= -->

                <aside class="right-column">


                    <!-- ================= PROFILE ================= -->

                    <section class="profile-card panel">

                        <div class="profile-head">

                            <div class="big-avatar">
                                <img src="/uploads/<%= user.photo %>">
                            </div>

                            <div>

                                <h2>
                                    <%= user.name %>
                                </h2>

                                <p>
                                    Student
                                </p>

                            </div>

                        </div>


                        <div class="profile-info">

                            <p>
                                <i class="fa-solid fa-building-columns"></i>
                                ITM University Gwalior
                            </p>


                            <p>
                                <i class="fa-solid fa-graduation-cap"></i>
                                 <%= user.course %>
                            </p>


                            <p>
                                <i class="fa-regular fa-calendar"></i>
                                <%= user.year%>
                            </p>

                        </div>


                        <button class="edit-btn" href="/main/profile/edit">
                           <a href="/main/profile/edit"> Edit Profile </a> 
                        </button>

                    </section>



                    <!-- ================= UPCOMING EVENTS ================= -->

                    <section class="panel events-panel">

                        <div class="panel-header">

                            <h2>
                                <i class="fa-regular fa-calendar"></i>
                                Upcoming Events
                            </h2>

                            <a href="/main/events">
                                View All →
                            </a>

                        </div>



                        <div class="event-item">

                            <div class="date-box">
                                <b>15</b>
                                <span>Sep</span>
                            </div>

                            <div>

                                <h3>
                                    Tech Talk: Building Scalable Systems
                                </h3>

                                <p>
                                    <i class="fa-regular fa-clock"></i>
                                    10:00 AM - 12:00 PM
                                </p>

                                <p>
                                    <i class="fa-solid fa-location-dot"></i>
                                    Auditorium
                                </p>

                            </div>

                        </div>



                        <div class="event-item">

                            <div class="date-box">
                                <b>18</b>
                                <span>Sep</span>
                            </div>

                            <div>

                                <h3>
                                    Cultural Fest - Registrations Open
                                </h3>

                                <p>
                                    <i class="fa-regular fa-clock"></i>
                                    All Day
                                </p>

                                <p>
                                    <i class="fa-solid fa-location-dot"></i>
                                    Campus Grounds
                                </p>

                            </div>

                        </div>



                        <div class="event-item">

                            <div class="date-box">
                                <b>22</b>
                                <span>Sep</span>
                            </div>

                            <div>

                                <h3>
                                    Hackathon 2025
                                </h3>

                                <p>
                                    <i class="fa-regular fa-clock"></i>
                                    9:00 AM - 6:00 PM
                                </p>

                                <p>
                                    <i class="fa-solid fa-location-dot"></i>
                                    Lab Block
                                </p>

                            </div>

                        </div>



                        <div class="event-item">

                            <div class="date-box">
                                <b>28</b>
                                <span>Sep</span>
                            </div>

                            <div>

                                <h3>
                                    Guest Lecture: Career in Data Science
                                </h3>

                                <p>
                                    <i class="fa-regular fa-clock"></i>
                                    11:00 AM - 1:00 PM
                                </p>

                                <p>
                                    <i class="fa-solid fa-location-dot"></i>
                                    Seminar Hall
                                </p>

                            </div>

                        </div>

                    </section>



                    <!-- ================= COMMUNITY ================= -->

                    <section class="panel community-card">

                        <div class="panel-header">

                            <h2>
                                <i class="fa-solid fa-users"></i>
                                Your Community
                            </h2>

                            <a href="/main/community">
                                View All →
                            </a>

                        </div>


                        <div class="community-content">

                            <div class="mini-avatars">

                                <span>AK</span>
                                <span>RS</span>
                                <span>VP</span>
                                <span>MK</span>

                            </div>


                            <div>

                                <strong>
                                    1.2k+ students
                                </strong>

                                <p>
                                    Active in your college
                                </p>

                            </div>

                        </div>

                    </section>

                </aside>

            </section>

        </main>

    </div>

</body>
</html>