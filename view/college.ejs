
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>College Info | CampusHub</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="/college.css">
</head>

<body>

    <main class="college-page">

        <div class="college-card">

            <div class="college-icon">
                <i class="fa-solid fa-building-columns"></i>
            </div>

            <h1>ITM University Gwalior</h1>

            <p class="location">
                <i class="fa-solid fa-location-dot"></i>
                Gwalior, Madhya Pradesh
            </p>

            <div class="college-info">

                <div class="info-item">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <div>
                        <span>University</span>
                        <strong>ITM University Gwalior</strong>
                    </div>
                </div>

                <div class="info-item">
                    <i class="fa-solid fa-code"></i>
                    <div>
                        <span>Program</span>
                        <strong>B.Tech Data Science</strong>
                    </div>
                </div>

                <div class="info-item">
                    <i class="fa-solid fa-map-pin"></i>
                    <div>
                        <span>Campus</span>
                        <strong>Gwalior, Madhya Pradesh</strong>
                    </div>
                </div>

            </div>

            <a
                href="https://itmuniversity.ac.in/"
                target="_blank"
                rel="noopener noreferrer"
                class="official-link">

                Visit Official Website
                <i class="fa-solid fa-arrow-up-right-from-square"></i>

            </a>

            <a href="/main" class="back-link">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Dashboard
            </a>

        </div>

    </main>

</body>
</html>